# Vite auto-switches these files:
#   npm run dev   -> .env.development  (local)
#   npm run build -> .env.production   (live)

# --- LOCAL (copy to .env.development) ---
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_APP_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5173

# --- LIVE (copy to .env.production) ---
# VITE_API_BASE_URL=https://api.postafly.com
# VITE_APP_URL=https://app.postafly.com
# VITE_ADMIN_URL=https://admin.postafly.com
